# Upstash Redis — visitor counter
# Create via: https://vercel.com/marketplace/upstash
# or: npx vercel integration add upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CV upload admin (hidden portal + protected API)
# Random long secret used by /api/cv/upload via x-cv-admin-key header
CV_ADMIN_KEY=

# Vercel Blob token for storing updated CV files
# In Vercel, this is usually injected automatically after creating Blob storage.
BLOB_READ_WRITE_TOKEN=
